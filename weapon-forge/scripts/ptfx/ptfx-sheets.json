{
  "sheet_fire": {
    "about": "25-frame looping turbulent flame with shredded tongues. Tint it with the layer colour; stack a smaller pale layer for a hot core.",
    "grid": "5x5", "size": 512, "loop": 1,
    "flipbook": { "shape": "fire", "corePower": 1.15 }, "animate": { "phase": [0, 1] }
  },
  "sheet_energy": {
    "about": "25-frame looping plasma filaments. Energy weapons, spirits, cores.",
    "grid": "5x5", "size": 512, "loop": 1,
    "flipbook": { "shape": "plasma" }, "animate": { "phase": [0, 1] }
  },
  "sheet_vortex": {
    "about": "16-frame looping spiral whose arms flow inward. Portals, dark and galaxy sets.",
    "grid": "4x4", "size": 512, "loop": 1,
    "flipbook": { "shape": "swirl", "points": 3, "twist": 3.2 }, "animate": { "phase": [0, 1] }
  },
  "sheet_wisps": {
    "about": "16-frame looping multi-strand smoke tendrils that sway. Spirit, demon and poison sets.",
    "grid": "4x4", "size": 512, "loop": 1,
    "flipbook": { "shape": "wisp", "thickness": 0.08 }, "animate": { "phase": [0, 1] }
  },
  "sheet_arcs": {
    "about": "Four fractal lightning bolts with tapered tips. Use anim random so each arc keeps changing.",
    "grid": "2x2", "size": 512,
    "flipbook": { "shape": "bolt", "branches": 3, "jag": 0.22 }, "animate": { "seed": 1 }
  },
  "sheet_cracks": {
    "about": "Four different crack bursts for ground or glass breaks.",
    "grid": "2x2", "size": 512,
    "flipbook": { "shape": "crack" }, "animate": { "seed": 1 }
  },
  "sheet_puffs": {
    "about": "Four soft smoke puffs drawn by the generator, for stylised smoke that does not use the game's sheet.",
    "grid": "2x2", "size": 512,
    "flipbook": { "shape": "smoke" }, "animate": { "seed": 1 }
  },
  "sheet_splats": {
    "about": "Four paint or ink splats.",
    "grid": "2x2", "size": 512,
    "flipbook": { "shape": "splat" }, "animate": { "seed": 1 }
  },
  "sheet_shards": {
    "about": "Four crystal fragments of different proportions.",
    "grid": "2x2",
    "cells": [ "shard", { "shape": "shard", "aspect": 0.6, "rotation": 30 }, { "shape": "diamond", "aspect": 0.55 }, { "shape": "triangle", "aspect": 0.7, "rotation": 15 } ]
