{
    "description": "infrontofx skill router: reads each prompt and tells the model which infrontofx skills to load (20-40 tokens, nothing when no rule matches)",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-router.sh\"",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
